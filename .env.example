# MCP Gateway Configuration Example
AWS_REGION=ap-northeast-1
DOMAIN_NAME=mcp.example.com
HOSTED_ZONE_ID=Z01234567890ABCDEFGH
CERTIFICATE_ARN=arn:aws:acm:ap-northeast-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
COGNITO_DOMAIN=myprivate-auth-123456789012.auth.ap-northeast-1.amazoncognito.com
CLIENT_CALLBACK_URL=https://oauth-redirect.googleusercontent.com/r/user_bound_custom-mcp-xxxxxxxxxxxxxxxxxxxxx
TARGETS_PARAMETER_NAME=/mcp-gateway/targets
SAM_S3_BUCKET=sam-artifacts-123456789012-ap-northeast-1
